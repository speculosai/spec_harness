# Dependencies
node_modules/
.pnpm-store/
.pnp
.pnp.js
jspm_packages/

# npm is the package manager of record; package-lock.json is tracked.
# A stray pnpm lockfile is not maintained and should not be committed.
pnpm-lock.yaml

# Build output
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
.vite/
.builds/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
.Python
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/

# Packaging
*.whl
*.tar.gz

# Environment / secrets - never commit real keys
.env
.env.*
!.env.example

# Local databases (reference SQLite / FS stores)
*.db
*.sqlite
*.sqlite3
projects.db
speculos-harness.db

# Logs and coverage
*.log
npm-debug.log*
pnpm-debug.log*
coverage/
.coverage
htmlcov/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
