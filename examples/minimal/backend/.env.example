# Minimal Speculos Harness backend — example environment.
#
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# Every value below is an OBVIOUS placeholder. Never commit a real key.

# --- LLM provider ----------------------------------------------------------

# Your provider API key. This example defaults the model to openai/gpt-4.1,
# so an OpenAI key is what it reads. Swap the model (HARNESS_MODEL) and the key
# together if you use Anthropic, Bedrock, or a local model.
OPENAI_API_KEY=sk-your-key-here

# The company-wide default model, in LiteLLM notation. Optional; defaults to
# openai/gpt-4.1. Examples:
#   openai/gpt-4.1
#   anthropic/claude-sonnet-5
#   ollama/llama3.3          (local, no key required)
HARNESS_MODEL=openai/gpt-4.1

# Optional: route through an existing LiteLLM proxy to inherit its budgets,
# keys, and spend logs. Leave unset to call the provider directly.
# LITELLM_PROXY=http://your-litellm-proxy:4000

# --- Build service ---------------------------------------------------------

# Where the bundler sidecar is reachable. In docker-compose this is the
# `bundler` service; running locally it might be http://localhost:8081.
BUNDLER_URL=http://bundler:8081
