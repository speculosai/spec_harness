# Minimal Speculos Harness backend - example environment.
#
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# Every value below is an OBVIOUS placeholder. Never commit a real key.
#
# `docker compose up` from ../ reads ANTHROPIC_API_KEY straight from your shell,
# so this file is what you need when running the backend on its own with uvicorn.

# --- LLM provider ----------------------------------------------------------

# Your provider key. This example defaults to anthropic/claude-fable-5, so an
# Anthropic key is what it reads. Swap the model (HARNESS_MODEL) and the key
# together for any other LiteLLM-supported provider. Inference is billed by your
# provider, on your keys - no markup.
ANTHROPIC_API_KEY=sk-ant-...

# The company-wide default model, in LiteLLM notation. Optional; defaults to
# anthropic/claude-fable-5. The in-chat picker's menu is `allowed_models` in
# main.py:
#   anthropic/claude-fable-5
#   openai/gpt-5.6-sol
#   zai/glm-5.2              (open weights)
HARNESS_MODEL=anthropic/claude-fable-5

# Optional: route through an existing LiteLLM proxy to inherit its budgets,
# keys, and spend logs. Leave unset to call the provider directly.
# LITELLM_PROXY=http://your-litellm-proxy:4000

# --- Build service ---------------------------------------------------------

# Where the bundler sidecar is reachable. In docker-compose this is the
# `bundler` service; running locally it is http://localhost:8081.
BUNDLER_URL=http://bundler:8081
