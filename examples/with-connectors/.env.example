# With-connectors backend - example environment.
#
# Copy to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# Every value below is an OBVIOUS placeholder. Never commit a real key.

# --- LLM provider ----------------------------------------------------------

# Provider key for the default model (anthropic/claude-fable-5). Swap the model
# (HARNESS_MODEL) and key together for any other LiteLLM-supported provider.
ANTHROPIC_API_KEY=sk-ant-...

# Company-wide default model, in LiteLLM notation.
HARNESS_MODEL=anthropic/claude-fable-5

# --- Data connectors -------------------------------------------------------

# Base database connection string. The per-tenant resolver in main.py derives
# each tenant's database from this - for a single-tenant deploy, use it directly.
DATABASE_URL=postgresql://user:pass@db/northwind

# MCP server URLs (open standard - one adapter reaches any of them).
NOTION_MCP_URL=https://your-mcp-host.example/notion
LINEAR_MCP_URL=https://your-mcp-host.example/linear

# --- Build service ---------------------------------------------------------

BUNDLER_URL=http://bundler:8081
