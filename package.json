{
  "name": "speculos-harness",
  "version": "0.1.3",
  "private": true,
  "description": "Monorepo root for Speculos Harness - an embeddable AI app-building workspace: a chat panel beside a live preview, in your own product.",
  "license": "Apache-2.0",
  "homepage": "https://speculos.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speculosai/spec_harness.git"
  },
  "bugs": {
    "url": "https://github.com/speculosai/spec_harness/issues"
  },
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "selfcheck": "bun run packages/spec_harness/src/preview.self-check.ts",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "19",
    "@types/react-dom": "19",
    "typescript": "5.7"
  },
  "workspaces": [
    "packages/*",
    "examples/minimal/web",
    "examples/frontend-only"
  ]
}
