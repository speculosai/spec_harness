{
  "name": "@speculos-harness/react",
  "version": "0.1.0",
  "description": "The embeddable Speculos Harness workspace for React - <HarnessProvider>/<Builder>, composable panes, and headless hooks.",
  "license": "Apache-2.0",
  "homepage": "https://speculos.ai",
  "type": "module",
  "main": "./src/index.tsx",
  "module": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@speculos-harness/protocol": "workspace:*",
    "@speculos-harness/preview": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
