{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "bun"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ]
}
